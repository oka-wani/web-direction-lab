{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-direction-lab",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "routes": [
    {
      "pattern": "www.wani-san.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "67272fbd3a2544e7be39b528e4f13dd1"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://www.wani-san.com"
  }
}
