---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SiteHeader, SiteFooter } from "../../app/components/SiteChrome";
import { columnItems } from "../../app/column/column-data";

const topics = [
  { title: "ホームページ制作", description: "費用・ページ構成・CMSを考える", label: "PLAN" },
  { title: "運用・改善", description: "公開後の課題を見つけて改善する", label: "IMPROVE" },
  { title: "SEO・解析", description: "検索とアクセスのデータを読む", label: "MEASURE" },
];
const latest = [...columnItems].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);
---
<BaseLayout title="Wani san Web｜Web制作・運用・改善の実務メディア" description="Webサイトの企画から公開後の改善まで。ホームページ制作、CMS、SEO、アクセス解析の判断に役立つ記事を届けます。" publication>
  <SiteHeader client:load current="home" />
  <main class="editorial">
    <section class="intro">
      <div class="wrap">
        <p class="eyebrow">WANI SAN WEB JOURNAL</p>
        <h1>Webサイトをつくる。<br />育てる。考える。</h1>
        <p class="intro-copy">企画・制作から公開後の運用まで。<br />Web担当者が、次の一手を決めるための実務メディア。</p>
        <a class="primary" href="#latest">新着記事を読む <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section class="wrap topic-section" aria-labelledby="topics-heading">
      <p class="eyebrow">TOPICS</p>
      <h2 id="topics-heading">テーマから探す</h2>
      <ul class="topics">
        {topics.map((topic) => (
          <li><a href={`/column/?category=${encodeURIComponent(topic.title)}`}>
            <span class="topic-label">{topic.label}</span>
            <strong>{topic.title} <span aria-hidden="true">↗</span></strong>
            <span>{topic.description}</span>
          </a></li>
        ))}
      </ul>
    </section>

    <section class="wrap latest" id="latest" aria-labelledby="latest-heading">
      <p class="eyebrow">LATEST</p>
      <h2 id="latest-heading">新着記事</h2>
      <ul class="articles">
        {latest.map((item) => (
          <li><article><a href={`/column/${item.slug}/`}>
            <div class="meta"><time datetime={item.date.replaceAll(".", "-")}>{item.date}</time><span>{item.category}</span></div>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <span class="read">記事を読む <span aria-hidden="true">→</span></span>
          </a></article></li>
        ))}
      </ul>
      <a class="archive" href="/column/">記事一覧へ <span aria-hidden="true">→</span></a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .editorial { color: #111715; background: #fff; }
  .wrap { width: min(1080px, calc(100% - 48px)); margin-inline: auto; }
  .intro { padding-block: clamp(56px, 9vw, 112px); background: #eaf3ed; border-bottom: 1px solid #d0e2d5; }
  .eyebrow, .topic-label { color: #075b3a; font-size: .8rem; font-weight: 800; letter-spacing: .12em; }
  h1 { margin-block: 20px; font-size: clamp(2.4rem, 7vw, 5.2rem); line-height: 1.12; letter-spacing: -.055em; }
  .intro-copy { font-size: clamp(1rem, 2vw, 1.2rem); line-height: 1.85; }
  .primary { display: inline-flex; gap: 1rem; margin-top: 24px; padding: 12px 20px; color: #fff; background: #075b3a; border-radius: 4px; font-weight: 700; }
  .primary:hover { background: #06452d; }
  .topic-section, .latest { padding-block: clamp(44px, 7vw, 76px); }
  .latest { border-top: 1px solid #d0e2d5; scroll-margin-top: 100px; }
  h2 { margin: 8px 0 24px; font-size: clamp(1.75rem, 4vw, 2.5rem); }
  .topics, .articles { margin: 0; padding: 0; list-style: none; }
  .topics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .topics a { display: grid; gap: 8px; height: 100%; padding: 20px; background: #f4f8f5; border: 1px solid #d0e2d5; border-radius: 4px; }
  .topics strong { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 1.15rem; }
  .topics a:hover, .articles a:hover { background: #eaf3ed; }
  .articles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 28px; }
  .articles li { border-top: 1px solid #d0e2d5; }
  .articles article { height: 100%; }
  .articles a { display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 22px 12px; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; font-size: .85rem; color: #345347; }
  h3 { margin: 0; font-size: 1.25rem; line-height: 1.5; }
  .articles p { margin: 0; line-height: 1.7; }
  .read { margin-top: auto; }
  .read, .archive { color: #075b3a; font-weight: 700; }
  .archive { display: inline-block; margin-top: 24px; text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 680px) {
    .wrap { width: calc(100% - 32px); }
    .topics, .articles { grid-template-columns: 1fr; }
  }
</style>
