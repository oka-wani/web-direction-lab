{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-direction-lab",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "routes": [
    {
      "pattern": "www.wani-san.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "PROPOSALS",
      "bucket_name": "wsw-proposals"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "67272fbd3a2544e7be39b528e4f13dd1"
    }
  ],
  "workflows": [
    {
      "name": "wsw-proposal-generation",
      "binding": "PROPOSAL_WORKFLOW",
      "class_name": "ProposalWorkflowV2"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://www.wani-san.com"
  }
}
